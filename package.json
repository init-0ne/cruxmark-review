{
  "name": "cruxmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "forge build --root contracts && vite --host 127.0.0.1",
    "build": "forge build --root contracts && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "contracts:format": "forge fmt --root contracts",
    "check": "pnpm run build && forge fmt --root contracts --check && pnpm run contracts:test && pnpm run execution:test",
    "doctor": "node scripts/doctor.mjs",
    "chain": "anvil --host 127.0.0.1 --chain-id 31337 --silent",
    "deploy:local": "forge script contracts/script/DeploySandbox.s.sol:DeploySandbox --root contracts --rpc-url http://127.0.0.1:8545 --unlocked --sender 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 --broadcast",
    "execution:test": "node scripts/check-execution.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/cast": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
