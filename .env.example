# Browser-visible, public configuration only. Never put a key in VITE_*.
# Valid targets: local, robinhood-testnet, arbitrum-sepolia.
VITE_NETWORK=local
# Optional public RPC override. Leave empty to use the selected chain default.
VITE_RPC_URL=
# Deployed ScenarioFactory address enabling live wallet execution.
# After pnpm run deploy:local, set this to the factory address in .env.local.
VITE_FACTORY_ADDRESS=
